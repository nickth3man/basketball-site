{
  "printWidth": 100,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "avoid",
  "htmlWhitespaceSensitivity": "strict",
  "singleAttributePerLine": false,
  "endOfLine": "lf",
  "tailwindStylesheet": "./src/app/globals.css",
  "tailwindFunctions": ["clsx", "cn", "cva"],
  "plugins": ["prettier-plugin-tailwindcss"]
}
