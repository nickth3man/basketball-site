{
    "compilerOptions": {
        "target": "es2017",
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "incremental": true,
        "plugins": [
            {
                "name": "next"
            }
        ],
        "paths": {
            "@/*": [
                "./src/*"
            ]
        },
        "allowSyntheticDefaultImports": true,
        "resolvePackageJsonExports": true,
        "resolvePackageJsonImports": true,
        "preserveConstEnums": true,
        "noImplicitAny": true,
        "noImplicitThis": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "strictBindCallApply": true,
        "strictPropertyInitialization": true,
        "strictBuiltinIteratorReturn": true,
        "alwaysStrict": true,
        "useUnknownInCatchVariables": true
    },
    "files": [
        "./next-env.d.ts",
        "./next.config.ts",
        "./vitest.config.ts",
        "./src/test-setup.ts",
        "./src/app/api/export/[type]/route.ts",
        "./src/app/api/export/[type]/__tests__/route.test.ts",
        "./src/app/api/search/route.ts",
        "./src/app/api/search/__tests__/route.test.ts",
        "./src/lib/db.test.ts",
        "./src/lib/db.ts",
        "./src/lib/formatters.ts",
        "./src/lib/table-styles.ts",
        "./src/lib/utils.ts",
        "./src/lib/queries/games.ts",
        "./src/lib/queries/index.test.ts",
        "./src/lib/queries/index.ts",
        "./src/lib/queries/players.ts",
        "./src/lib/queries/seasons.ts",
        "./src/lib/queries/teams.ts",
        "./src/lib/query/directory.ts",
        "./src/lib/query/home.ts",
        "./src/lib/query/search.ts",
        "./src/app/layout.tsx",
        "./src/app/page.tsx",
        "./src/app/games/page.tsx",
        "./src/app/games/[id]/page.tsx",
        "./src/app/players/page.tsx",
        "./src/app/players/[id]/page.tsx",
        "./src/app/seasons/page.tsx",
        "./src/app/seasons/[year]/page.tsx",
        "./src/app/teams/page.tsx",
        "./src/app/teams/[abbrev]/page.tsx",
        "./src/components/search-box.test.tsx",
        "./src/components/search-box.tsx",
        "./src/components/site-header.tsx",
        "./src/components/stats-table.test.tsx",
        "./src/components/stats-table.tsx",
        "./.next/types/routes.d.ts",
        "./.next/types/validator.ts",
        "./.next/dev/types/cache-life.d.ts",
        "./.next/dev/types/routes.d.ts",
        "./.next/dev/types/validator.ts"
    ],
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts",
        "**/*.mts"
    ],
    "exclude": [
        "node_modules"
    ]
}
