# Git Attributes
# https://git-scm.com/docs/gitattributes

# ============================================
# LINE ENDINGS
# ============================================

# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Source code
*.ts text eol=lf linguist-language=TypeScript
*.tsx text eol=lf linguist-language=TypeScript
*.js text eol=lf linguist-language=JavaScript
*.jsx text eol=lf linguist-language=JavaScript
*.mjs text eol=lf linguist-language=JavaScript
*.cjs text eol=lf linguist-language=JavaScript
*.json text eol=lf
*.jsonc text eol=lf

# Styles
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.less text eol=lf
*.pcss text eol=lf

# Markup
*.html text eol=lf linguist-language=HTML
*.htm text eol=lf linguist-language=HTML
*.xml text eol=lf
*.svg text eol=lf
*.md text eol=lf linguist-language=Markdown
*.mdx text eol=lf linguist-language=Markdown

# Documentation
*.txt text eol=lf
LICENSE text eol=lf
LICENSE.* text eol=lf
AUTHORS text eol=lf
CHANGELOG* text eol=lf
CONTRIBUTING* text eol=lf
SECURITY* text eol=lf
CODE_OF_CONDUCT* text eol=lf

# Config files
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
*.config.* text eol=lf
*.conf text eol=lf
.env text eol=lf
.env.* text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Makefiles
Makefile text eol=lf
makefile text eol=lf
*.mk text eol=lf

# YAML configs
*.yml text eol=lf linguist-language=YAML
*.yaml text eol=lf linguist-language=YAML

# ============================================
# BINARY FILES (no diff, no line ending conversion)
# ============================================

# Database files
*.db binary
*.sqlite binary
*.sqlite3 binary

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.bmp binary
*.tiff binary
*.tif binary

# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

# Archives
*.zip binary
*.tar binary
*.gz binary
*.bz2 binary
*.7z binary
*.rar binary

# Media
*.mp3 binary
*.mp4 binary
*.webm binary
*.ogg binary
*.wav binary
*.flac binary
*.mov binary
*.avi binary

# Documents
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary

# ============================================
# GIT LFS (Large File Storage)
# ============================================

# Database files in Git LFS
*.db filter=lfs diff=lfs merge=lfs -text

# ============================================
# DIFF BEHAVIOR
# ============================================

*.md diff=markdown
*.json diff=json
*.html diff=html
*.css diff=css

# ============================================
# MERGE BEHAVIOR
# ============================================

# Lock files - ours strategy
package-lock.json merge=ours
yarn.lock merge=ours
pnpm-lock.yaml merge=ours

# Generated files - ours strategy
.github/workflows/*.lock.yml merge=ours linguist-generated=true

# ============================================
# LINGUIST OVERRIDES (GitHub language detection)
# ============================================

# SQL files
*.sql linguist-language=SQL

# Shell scripts
scripts/*.sh linguist-language=Shell

# Generated files
next-env.d.ts linguist-generated=true
*.config.js linguist-generated
*.config.ts linguist-generated
