{
  // ============================================
  // EDITOR FORMATTING - STRICT ENFORCEMENT
  // ============================================
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,
  "editor.formatOnType": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  // ============================================
  // LANGUAGE-SPECIFIC FORMATTERS
  // ============================================
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // ============================================
  // ESLINT INTEGRATION - STRICT AUTO-FIX
  // ============================================
  "eslint.enable": true,
  "eslint.format.enable": false,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "eslint.workingDirectories": [
    {
      "pattern": "nba-reference/*"
    }
  ],
  "eslint.useFlatConfig": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "never"
  },
  "editor.codeActionsOnSaveTimeout": 3000,

  // ============================================
  // TYPESCRIPT - STRICT WORKSPACE VERSION
  // ============================================
  "js/ts.tsdk.path": "nba-reference/node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.preferences.importModuleSpecifier": "relative",
  "js/ts.preferences.quoteStyle": "single",
  "typescript.preferences.includePackageTypeInDeclarationImports": true,
  "js/ts.tsc.autoDetect": "off",
  "js/ts.format.enabled": false,
  "js/ts.validate.enabled": true,
  "js/ts.suggest.autoImports": true,
  "typescript.suggest.includeCompletionsForModuleExports": true,

  // ============================================
  // TAILWIND CSS
  // ============================================
  "tailwindCSS.includeLanguages": {
    "typescript": "javascript",
    "typescriptreact": "javascript"
  },
  "tailwindCSS.classAttributes": [
    "class",
    "className",
    "ngClass",
    ".*ClassName",
    ".*Styles"
  ],
  "tailwindCSS.emmetCompletions": true,
  "tailwindCSS.experimental.classRegex": [
    ["clsx\\(([^)]*)\\)", "'|\"|`([^']*|[^\"]*|[^`]*)"],
    ["cn\\(([^)]*)\\)", "'|\"|`([^']*|[^\"]*|[^`]*)"],
    ["cva\\(([^)]*)\\)", "'|\"|`([^']*|[^\"]*|[^`]*)"]
  ],

  // ============================================
  // CSS - DISABLE BUILT-IN VALIDATOR FOR TAILWIND
  // ============================================
  "css.validate": false,
  "scss.validate": false,
  "less.validate": false,
  "files.associations": {
    "*.css": "tailwindcss"
  },

  // ============================================
  // EDITOR BEHAVIOR - STRICT CONSISTENCY
  // ============================================
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.rulers": [100],
  "editor.wordWrap": "wordWrapColumn",
  "editor.wordWrapColumn": 100,
  "editor.quickSuggestions": {
    "strings": true
  },
  "editor.suggestSelection": "first",
  "editor.acceptSuggestionOnCommitCharacter": false,
  "editor.trimAutoWhitespace": true,

  // ============================================
  // FILE SETTINGS
  // ============================================
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.exclude": {
    "**/.next": true,
    "**/node_modules": true,
    "**/coverage": true,
    "**/*.log": true,
    "**/*.db-shm": true,
    "**/*.db-wal": true,
    "**/tsconfig.tsbuildinfo": true
  },

  // ============================================
  // SEARCH SETTINGS
  // ============================================
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/out": true,
    "**/build": true,
    "**/*.code-search": true,
    "**/*.db": true
  },

  // ============================================
  // PRETTIER SETTINGS — PATHS ADJUSTED FOR ROOT
  // ============================================
  "prettier.configPath": "nba-reference/.prettierrc.json",
  "prettier.ignorePath": "nba-reference/.prettierignore",

  // ============================================
  // GIT SETTINGS
  // ============================================
  "git.ignoreLimitWarning": true,

  // ============================================
  // EXPLORER SETTINGS
  // ============================================
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.test.ts, ${capture}.test.tsx",
    "*.tsx": "${capture}.test.ts, ${capture}.test.tsx",
    ".prettierrc.json": ".prettierignore",
    ".eslintrc.*": ".eslintignore",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb",
    "tsconfig.json": "tsconfig.*.json",
    "next.config.ts": "next-env.d.ts"
  },

  // ============================================
  // ERROR & PROBLEMS — WORKSPACE-WIDE DIAGNOSTICS
  // ============================================
  "problems.decorations.enabled": true,
  "problems.showCurrentContext": true,
  "js/ts.reportStyleChecksAsWarnings": false,
  "typescript.tsserver.experimental.enableProjectDiagnostics": true,
  "eslint.lintTask.enable": true,

  // ============================================
  // DEBUGGING
  // ============================================
  "debug.javascript.autoAttachFilter": "smart",

  // ============================================
  // EXTENSION SETTINGS
  // ============================================
  "extensions.ignoreRecommendations": false
}
